DB_DRIVER=memory
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=iot_monitoring
DB_USER=iot_app
DB_PASSWORD=replace_with_your_password

# Điền địa chỉ broker để nhận telemetry thật; bỏ trống để dùng dữ liệu hiện có.
MQTT_URL=
MQTT_USERNAME=
MQTT_PASSWORD=

# Simulate disconnected MQTT without connecting to the broker.
MQTT_SIMULATION=false
