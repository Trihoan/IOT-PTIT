{
  "name": "iot-monitoring",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "FE",
    "BE"
  ],
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "dev:fe": "npm run dev --workspace=FE",
    "dev:be": "npm run dev --workspace=BE",
    "build": "npm run build --workspace=BE && npm run build --workspace=FE",
    "typecheck": "npm run typecheck --workspace=BE && npm run typecheck --workspace=FE",
    "test": "npm test --workspace=BE",
    "start:fe": "npm start --workspace=FE",
    "start:be": "npm start --workspace=BE"
  }
}
